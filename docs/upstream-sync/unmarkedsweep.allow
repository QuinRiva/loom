# Files exempt from the unmarked-delta sweep (one path or prefix per line).
# Loom-only files (absent at the upstream base) are exempt automatically and
# do not belong here — this list is only for upstream-owned files whose delta
# is deliberately unmarked, with the reason.

# Lockfiles, generated and vendored trees: not hand-written fork code.
pnpm-lock.yaml
.repos/
# Generated licence manifest: JSON has no comment syntax, and its fork delta is
# just the notices for loom's extra dependencies (the pi packages, fastdom, …).
third-party-licenses.config.json

# Sync bookkeeping about the fork itself; markers would be noise.
docs/upstream-sync/

# Loom-owned prose (05-strategy.md §4.6): the whole file is loom's, so there is
# no upstream hunk to mark; upstream's edits are ported by hand at each pull.
AGENTS.md

# Provider model catalogue: JSON has no comment syntax. The fork delta is the
# model-generation rollovers loom applies ahead of upstream (Opus 5.5, GPT-6
# Sol/Luna); it is refreshed from upstream's copy at runtime anyway, so the
# delta is only the offline bundle.
apps/server/src/provider/model-manifest.json

# package.json files: JSON has no comment syntax. Their fork delta is the
# subpath-export map for loom-only modules, which the module names already name.
packages/shared/package.json
packages/client-runtime/package.json
# pull 10 (DL-921): JSON manifests cannot carry a marker — Loom deps and the provider-pi subpath exports
apps/server/package.json
apps/web/package.json
packages/provider-pi/package.json

# Generated by TanStack Router from the route files; a marker would be erased on
# the next regeneration, and the loom routes are named in the file list itself.
apps/web/src/routeTree.gen.ts

# Recorded Pi replay transcripts: NDJSON has no comment syntax. The fork delta
# is `"cwdOverride":"<any>"` on each recorded switch_session frame (driver plan
# §2 / Risk 4, doc 30); a re-recorded upstream fixture without it fails loudly.
apps/server/src/orchestration-v2/testkit/fixtures/provider_thread_resume/pi_transcript.ndjson
apps/server/src/orchestration-v2/testkit/fixtures/thread_rollback/pi_transcript.ndjson
apps/server/src/orchestration-v2/testkit/fixtures/thread_rollback_after_stop/pi_transcript.ndjson

# pull 13 (DL-1415): the root manifest cannot carry a marker. Loom's scripts:
# dev:seed, dev:seed:verify, dev:fake-hub, cockpit, cockpit:build, ship.
package.json

# pull 13 (DL-1473): JSON cannot carry a marker. Loom-only files and the +1 raises
# (FileBrowserPanel, MarkdownCodeBlock) are Loom's entries; next pull keeps them.
scripts/effect-budget.json
